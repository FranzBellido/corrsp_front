# Puerto publicado en docker-compose
PORT=3000

# Keycloak (mismo realm/client que en el servidor de identidad)
NUXT_PUBLIC_KEYCLOAK_URL=http://192.168.0.61:8080
NUXT_PUBLIC_KEYCLOAK_REALM=develop
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=afcoop

# API Nest: URL que usa el navegador del usuario
NUXT_PUBLIC_API_BASE_URL=http://192.168.0.26:3001

# URL del API accesible desde OnlyOffice (suele ser IP LAN del host del backend)
NUXT_PUBLIC_API_PUBLIC_URL=http://192.168.0.26:3001

NUXT_PUBLIC_ONLY_OFFICE_TOKEN=change-me
NUXT_PUBLIC_ONLY_OFFICE_SERVER=http://192.168.0.61:8095

# Docker Compose / Portainer stack: pegue estas líneas en "Environment variables"
# del stack (KEY=VALUE, una por línea). No sube .env al servidor con Portainer.
# IMAGE_TAG=latest
