# ---- Builder ----
FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# SPA (ssr: false): estas variables deben existir en el build
ARG NUXT_PUBLIC_KEYCLOAK_URL
ARG NUXT_PUBLIC_KEYCLOAK_REALM
ARG NUXT_PUBLIC_KEYCLOAK_CLIENT_ID
ARG NUXT_PUBLIC_API_BASE_URL
ARG NUXT_PUBLIC_API_PUBLIC_URL
ARG NUXT_PUBLIC_ONLY_OFFICE_TOKEN
ARG NUXT_PUBLIC_ONLY_OFFICE_SERVER

ENV NUXT_PUBLIC_KEYCLOAK_URL=$NUXT_PUBLIC_KEYCLOAK_URL
ENV NUXT_PUBLIC_KEYCLOAK_REALM=$NUXT_PUBLIC_KEYCLOAK_REALM
ENV NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=$NUXT_PUBLIC_KEYCLOAK_CLIENT_ID
ENV NUXT_PUBLIC_API_BASE_URL=$NUXT_PUBLIC_API_BASE_URL
ENV NUXT_PUBLIC_API_PUBLIC_URL=$NUXT_PUBLIC_API_PUBLIC_URL
ENV NUXT_PUBLIC_ONLY_OFFICE_TOKEN=$NUXT_PUBLIC_ONLY_OFFICE_TOKEN
ENV NUXT_PUBLIC_ONLY_OFFICE_SERVER=$NUXT_PUBLIC_ONLY_OFFICE_SERVER

RUN npm run build

# ---- Runtime ----
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=builder /app/.output ./.output

EXPOSE 3000
ENV PORT=3000
ENV HOST=0.0.0.0

CMD ["node", ".output/server/index.mjs"]
